# 环境变量示例（复制为 .env.local 并填真实值；切勿把真实值提交到 git，.gitignore 已忽略）

# JWT 签名密钥：生成方式 `openssl rand -base64 32`，注册/登录的 token 都用它签名
JWT_SECRET=

# Vercel KV（Redis）连接配置：在 Vercel 项目 Settings → Storage → KV 里创建后会自动注入
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=

# 以下由 Vercel 自动注入，本地开发可不填
# KV_URL=
# REDIS_URL=
# VERCEL_OIDC_TOKEN=

# Telegram Bot Token（推送用，可选）：在 @BotFather 创建 bot 后填入
# TG_BOT_TOKEN=

# 管理员账号（api/admin.js 里写法固定为 zoubo，见代码）
# CRON_SECRET=